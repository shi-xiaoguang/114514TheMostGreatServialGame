; ==================== 场景节点 ====================

[node name="MovementTest" type="Node3D"]

; 环境：背景与漫反射环境光来源
[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env_main")

; 平行光：参数与 world.tscn 完全一致（绕 Y 轴 -30°、绕 X 轴 -50° 组合旋转）
[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.866025, 0.383022, -0.321394, 0, 0.642788, 0.766044, 0.5, -0.663414, 0.55667, 0, 0, 0)
shadow_enabled = true

; 可见地面网格：保持默认 Transform（位于原点），地表自然落在 Y = 0
[node name="Ground" type="MeshInstance3D" parent="."]
mesh = SubResource("PlaneMesh_ground")
surface_material_override/0 = SubResource("Mat_ground")

; 地面碰撞体：整体下移 0.5m，使 1m 厚 Box 的顶面正好落在 Y = 0，与网格地表严格重合
[node name="GroundBody" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.5, 0)

; 地面碰撞形状：尺寸与位置全部由 Shape 与父节点决定，覆盖全部 80m × 80m
[node name="GroundCollision" type="CollisionShape3D" parent="GroundBody"]
shape = SubResource("Box_ground")

; ==================== AreaA_Start：平坦起点区（保持净空，不与任何障碍物重叠） ====================

[node name="AreaA_Start" type="Node3D" parent="."]

