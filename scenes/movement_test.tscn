; ---- E1-FLAT_BUMP 连续地形凸起：每处 = 30°上升段 + 水平顶部（长 0.6m）+ 30°下降段 ----
; 几何推导：30° 时水平投影 R = 高度 / tan30°；坡板厚 0.2m、宽 3m；坡板沿斜面的长度 = 2 × 高度。
; 因此 0.05 / 0.10 / 0.15m 三种高度分别需要长度 0.1 / 0.2 / 0.3m 的坡板，另加一块共用的 0.6m 水平顶部板。
[sub_resource type="BoxMesh" id="E1Bump005_Mesh"]
material = SubResource("Mat_calib")
size = Vector3(0.1, 0.2, 3)

[sub_resource type="BoxShape3D" id="E1Bump005_Shape"]
size = Vector3(0.1, 0.2, 3)

[sub_resource type="BoxMesh" id="E1Bump010_Mesh"]
material = SubResource("Mat_calib")
size = Vector3(0.2, 0.2, 3)

[sub_resource type="BoxShape3D" id="E1Bump010_Shape"]
size = Vector3(0.2, 0.2, 3)

[sub_resource type="BoxMesh" id="E1Bump015_Mesh"]
material = SubResource("Mat_calib")
size = Vector3(0.3, 0.2, 3)

[sub_resource type="BoxShape3D" id="E1Bump015_Shape"]
size = Vector3(0.3, 0.2, 3)

[sub_resource type="BoxMesh" id="E1BumpTop_Mesh"]
material = SubResource("Mat_calib")
size = Vector3(0.6, 0.2, 3)

[sub_resource type="BoxShape3D" id="E1BumpTop_Shape"]
size = Vector3(0.6, 0.2, 3)

