pixel_size = 0.012
billboard = 1
alpha_cut = 1
text = "A 平坦起点区"
font_size = 64
outline_size = 16

; ==================== AreaB_Rocks：假山岩石区 ====================
; 布局说明（代管：玩法设计负责人，缺少专业可用性测试）：
;   四组岩体分别位于 (-25, 6) / (-25, -5) / (-16.5, 1) / (-33, 6.5)，覆盖 x = -35 ~ -14 的西部区域；
;   每组岩体由球体、圆柱与少量石板错位叠放，避免全部呈现为规则方块；
;   每组岩体旁边配 0.3 ~ 0.7m 的矮岩顶，均可由当前 0.8m 的满按跳跃高度跳上去。

[node name="AreaB_Rocks" type="Node3D" parent="."]

