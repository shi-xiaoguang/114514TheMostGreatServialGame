outline_size = 16

; ==================== AreaB_Rocks：假山岩石区（WORLD-TEST-01 假山区优化） ====================
; 布局说明（代管：玩法设计负责人，缺少专业复核与可用性测试）：
;   主线 Route 共 8 级石台，自东（x≈-14）向西（x≈-35）逐级升高，每级顶面高差严格 0.35m：
;     0.35 / 0.70 / 1.05 / 1.40 / 1.75 / 2.10 / 2.45 / 2.80m；
;   每级落脚面为严格水平面（0°），边长 1.8 ~ 2.4m，均不小于 1.4m 的有效站立面积；
;   每级由「底座板 + 台面板」两层绕 Y 轴不同角度旋转的石块错位叠成，避免规则方盒堆砌；
;   底座板尺寸 3.4 ~ 4.0m、顶面高度互不相同（0.30 / 0.34 / 0.36 / 0.48 / 0.55 / 0.62m），
;   相邻底座互相重叠 → 形成连续石脊（同时作为失手落地的缓冲，但不替代逐级跳跃测试）；
;   相邻台面中心距约 3.2 ~ 3.4m，边到边水平间隙约 0.4 ~ 1.3m，行走速度下均可跨越；
;   Flanks 为落地侧翼石块（打破台阶轮廓）；Steep 为刻意保留、不可攀登的陡峭岩体；
;   Details 为低矮踏脚石，用于测试「从地面跳上较低岩石」。

[node name="AreaB_Rocks" type="Node3D" parent="."]

; 岩石区标牌
[node name="SignB" type="Label3D" parent="AreaB_Rocks"]
