; Robinson —— 运动测试地图（WORLD-TEST-01：80m × 80m 运动测试环境）
; 用途：为玩家控制器（PLAYER-01 / PLAYER-02）的后续开发与验收提供专用测试地形，本身不含任何新玩法。
; 生成方式：场景结构、网格 / 形状 / 材质 / 光照参数全部写在场景文件中，节点骨架与几何为一次写入的静态内容。
; 坐标系约定：地面网格与地面碰撞的顶面严格重合在 Y = 0；玩家出生点位于平坦起点区，出生时略高于地面再自然落地。
; 尺寸约定：测试地面 80m × 80m，XZ 覆盖范围为 -40 ~ +40，中心在原点。
; 分区约定（均挂在一个独立 Node3D 下，便于未来扩展与替换）：
;   AreaA_Start   平坦起点区（保持净空，仅放标牌与出生点）
;   AreaB_Rocks   假山岩石区（内置图元组合成岩体，网格与碰撞形状一一对应）
;   AreaC_Parkour 跑酷区（低难度路线 + 挑战路线，台面高度差 0.3 / 0.5 / 0.7m，间隙 1 / 2 / 3m）
;   AreaD_Slopes  坡道区（15° / 30° / 44° 可站立坡道，另预留一处 60° 陡坡地形）
; 碰撞约定：可见网格与碰撞形状使用完全相同的尺寸与 Transform，不使用非等比缩放，避免出现空气墙或隐形障碍。
; 复用约定：玩家直接实例化 res://scenes/player.tscn；天空 / 环境 / 平行光参数复制自 world.tscn 的既有取值。
; 范围声明：本场景不含死亡、生命值、体力、存档、传送、攀爬等功能，也不包含自动迈台阶、坡地跳跃衰减、陡坡滑动等机制。
; 说明：Godot 编辑器保存场景时会丢弃本文件内的 ; 注释，此现象不影响场景功能。

[gd_scene load_steps=60 format=3]

; 玩家场景：复用既有第一人称玩家，不创建第二套玩家控制器
[ext_resource type="PackedScene" path="res://scenes/player.tscn" id="1_player"]

; ==================== 天空 / 环境 / 光照（复制 world.tscn 的既有参数） ====================

; 天空材质：程序化天空，不需要任何外部贴图
[sub_resource type="ProceduralSkyMaterial" id="Sky_mat"]
sky_top_color = Color(0.32, 0.51, 0.78, 1)
sky_horizon_color = Color(0.72, 0.79, 0.87, 1)
ground_bottom_color = Color(0.18, 0.18, 0.2, 1)
ground_horizon_color = Color(0.72, 0.79, 0.87, 1)

[sub_resource type="Sky" id="Sky_main"]
sky_material = SubResource("Sky_mat")

; 环境：以天空作为背景与环境光源，避免地面背光面全黑
[sub_resource type="Environment" id="Env_main"]
background_mode = 2
sky = SubResource("Sky_main")

; ==================== 材质（全部为内置 StandardMaterial3D 纯色，不加载外部贴图） ====================

; 地面材质：与 world.tscn 完全一致的草地绿
[sub_resource type="StandardMaterial3D" id="Mat_ground"]
albedo_color = Color(0.44, 0.58, 0.34, 1)
roughness = 1.0

; 岩石材质：偏灰的石色，与平台、坡道在视觉上清楚区分
[sub_resource type="StandardMaterial3D" id="Mat_rock"]
albedo_color = Color(0.45, 0.43, 0.41, 1)
roughness = 0.95

; 低难度路线平台材质：偏绿，便于一眼识别
[sub_resource type="StandardMaterial3D" id="Mat_parkour_easy"]
albedo_color = Color(0.42, 0.62, 0.45, 1)
roughness = 0.9

; 挑战路线平台材质：偏红，便于一眼识别
[sub_resource type="StandardMaterial3D" id="Mat_parkour_hard"]
albedo_color = Color(0.72, 0.45, 0.38, 1)
roughness = 0.9

; 坡道材质：偏冷灰，与岩石、平台区分
[sub_resource type="StandardMaterial3D" id="Mat_ramp"]
albedo_color = Color(0.55, 0.55, 0.62, 1)
roughness = 0.85

; ==================== 地面网格与碰撞 ====================

; 地面网格：80m × 80m 的 PlaneMesh，默认躺在 XZ 平面、中心在原点、法线朝 +Y，因此地表高度恰为 Y = 0
[sub_resource type="PlaneMesh" id="PlaneMesh_ground"]
size = Vector2(80, 80)

; 地面碰撞形状：80m × 1m × 80m 的 Box，XZ 覆盖范围与网格完全一致（-40 ~ +40）
[sub_resource type="BoxShape3D" id="Box_ground"]
size = Vector3(80, 1, 80)

