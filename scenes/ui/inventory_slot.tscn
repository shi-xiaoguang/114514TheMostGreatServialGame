; Robinson —— 背包格场景（任务编号 UI-01：背包查看系统）
; 结构固定为 InventorySlot(Control) → Icon(TextureRect) / Name(Label) / Count(Label)，
; 该结构为未来的物品图标、tooltip 与选中状态预留；本阶段只显示名称与数量。
; 尺寸约定：自定义最小尺寸 84 × 96 像素，内部三个子节点按固定偏移排布，不随窗口缩放重排。
; 本阶段格子不绘制独立背景，靠网格间距与整体面板底色区分。
; 说明：Godot 编辑器保存场景时会丢弃本文件内的 ; 注释，此现象不影响场景功能。

[gd_scene load_steps=2 format=3]

; 背包格脚本：负责把物品定义与数量写进三个子节点
[ext_resource type="Script" path="res://scripts/ui/inventory_slot.gd" id="1_slot"]

; 背包格根节点：纯 Control，不做交互，只做显示
[node name="InventorySlot" type="Control"]
custom_minimum_size = Vector2(84, 96)
script = ExtResource("1_slot")

; 图标位：水平居中、宽高 40×40，位于格子顶部；本阶段无图标资源，保持为空
[node name="Icon" type="TextureRect" parent="."]
anchor_left = 0.5
anchor_right = 0.5
offset_left = -20.0
offset_top = 4.0
offset_right = 20.0
offset_bottom = 44.0
expand_mode = 1

; 名称标签：横向撑满格子，居中显示物品显示名
[node name="Name" type="Label" parent="."]
anchor_right = 1.0
offset_left = 2.0
offset_top = 50.0
offset_right = -2.0
offset_bottom = 72.0
horizontal_alignment = 1
vertical_alignment = 1

; 数量标签：位于名称下方，居中显示 "x数量"
[node name="Count" type="Label" parent="."]
anchor_right = 1.0
offset_left = 2.0
offset_top = 72.0
offset_right = -2.0
offset_bottom = 94.0
horizontal_alignment = 1
vertical_alignment = 1
